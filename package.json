{
  "name": "pia",
  "version": "0.13.0",
  "description": "PIA — Personal Integrated Applications. A standalone web terminal.",
  "homepage": "https://pia.tor2dbear.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/tor2dbear/pia-terminal.git"
  },
  "author": "tor2dbear",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-pyodide.mjs",
    "build": "tsc && vite build",
    "build:engine": "tsc -p tsconfig.engine.json && node scripts/build-engine.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "jsqr": "^1.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "qrcode-generator": "^2.0.4"
  }
}
